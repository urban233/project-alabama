# Local tools and generated evidence
.tools/
artifacts/
builds/
local-toolchain.json
local-asset-handoff.json

# Separate asset handoffs never belong in the public repository.
/project-alabama-*.zip
/project-alabama-*.zip.sha256
/project-alabama-*.zip.partial

# Supplied NFS World source archive stays local.
/asw-nfs-world.7z

# Artwork is distributed separately; restore it with tools/asset_pack.py.
/source-art/
/unity/Assets/Alabama/Art/
/unity/Assets/Alabama/Art.meta

# Supplied reference imagery has no established redistribution license.
docs/references/
# Untouched download contains embedded reference images; distribute the cleaned derivative.
source-art/third-party/blendswap/e46/original/

# Unity regenerates these; .meta files and package locks belong in Git.
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/.vs/
/unity/.idea/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.pdb
*.opendb
*.VC.db

# Generated by the transitive Unity performance-testing package during builds.
/unity/Assets/Resources.meta
/unity/Assets/Resources/PerformanceTestRunInfo.json
/unity/Assets/Resources/PerformanceTestRunInfo.json.meta
/unity/Assets/Resources/PerformanceTestRunSettings.json
/unity/Assets/Resources/PerformanceTestRunSettings.json.meta

# Blender backups and operating system metadata
*.blend1
*.blend2
__pycache__/
*.pyc
.DS_Store
Thumbs.db
